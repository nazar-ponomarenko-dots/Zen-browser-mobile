+package app.zen.mobile;
+
+import android.app.Activity;
+import android.app.DownloadManager;
+import android.content.ClipData;
+import android.content.Context;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.provider.OpenableColumns;
+import android.util.Log;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.WindowInsets;
+import android.view.WindowInsetsController;
+import android.webkit.MimeTypeMap;
+
+import org.mozilla.gecko.EventDispatcher;
+import org.mozilla.gecko.util.GeckoBundle;
+import org.mozilla.geckoview.GeckoResult;
+import org.mozilla.geckoview.GeckoRuntime;
+import org.mozilla.geckoview.GeckoSession;
+import org.mozilla.geckoview.GeckoSessionSettings;
+import org.mozilla.geckoview.GeckoView;
+import org.mozilla.geckoview.WebResponse;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Host activity for the standalone Zen/Gecko Android port.
+ *
+ * <p>M3 variant A: GeckoRuntime owns the Gecko bootstrap (mozglue -> libs ->
+ * nativeRun/XRE_main) and a GeckoSession opened with {@code chromeUri} makes
+ * GeckoViewSupport::Open hand the XUL browser.xhtml window to this view's
+ * LayerView surface (compositor, input and IME come with it).
+ */
+public class MainActivity extends Activity {
+
+    private static final String LOGTAG = "ZenDroid";
+    private static final String CHROME_URI = "chrome://browser/content/browser.xhtml";
+
+    private static final int REQUEST_FILE = 0x2A01;
+
+    // Edge-swipe and tap detection, see observeGestures(). The panel is revealed
+    // by a horizontal drag that starts within a narrow band at the left edge, so
+    // it stays inside the chrome and clear of the system back-gesture band.
+    private static final float EDGE_ZONE_DP = 24f;
+    private static final float SWIPE_DISTANCE_DP = 64f;
+    private static final float TAP_SLOP_DP = 12f;
+    private static final long TAP_MAX_MS = 250;
+
+    // Must match windowBackground in res/values/themes.xml.
+    private static final int ZEN_STARTUP_BG = 0xFF202020;
+
+    private float mEdgeZonePx;
+    private float mSwipeDistancePx;
+    private float mTapSlopPx;
+    private float mGestureDownX;
+    private float mGestureDownY;
+    private long mGestureDownTime;
+    private boolean mGestureFromEdge;
+    private boolean mGestureReported;
+    private int mGesturePointers;
+
+    // The runtime is per app process; survive Activity recreation.
+    private static GeckoRuntime sRuntime;
+
+    private GeckoView mView;
+    private GeckoSession mSession;
+
+    // Pending <input type=file> prompt bridged to SAF (zen-android #37).
+    private GeckoSession.PromptDelegate.FilePrompt mPendingFilePrompt;
+    private GeckoResult<GeckoSession.PromptDelegate.PromptResponse> mPendingFileResult;
+
+    @Override
+    protected void onCreate(final Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Log.i(LOGTAG, "MainActivity created; starting Gecko via GeckoRuntime (M3)");
+        if (sRuntime == null) {
+            sRuntime = GeckoRuntime.create(this);
+        }
+
+        mSession =
+                new GeckoSession(
+                        new GeckoSessionSettings.Builder().chromeUri(CHROME_URI).build());
+        mSession.setPromptDelegate(new PromptDelegate());
+        mSession.setContentDelegate(new ContentBridge());
+        // open() is asynchronous and queues until PROFILE_READY.
+        mSession.open(sRuntime);
+
+        mView = new GeckoView(this);
+        // GeckoView's surface wrapper starts at Color.WHITE and stays there
+        // until the first paint (GeckoView.init -> coverUntilFirstPaintInternal),
+        // which is what the user actually sees during Gecko's multi-second boot;
+        // the activity theme alone cannot cover it.
+        mView.coverUntilFirstPaint(ZEN_STARTUP_BG);
+        setContentView(mView);
+        mView.setSession(mSession);
+        hideSystemBars();
+
+        final float density = getResources().getDisplayMetrics().density;
+        mEdgeZonePx = EDGE_ZONE_DP * density;
+        mSwipeDistancePx = SWIPE_DISTANCE_DP * density;
+        mTapSlopPx = TAP_SLOP_DP * density;
+
+        Log.i(LOGTAG, "M3: GeckoView attached, chrome session opening for " + CHROME_URI);
+    }
+
+    // On API 35+ the manifest's Fullscreen theme flag is ignored (forced
+    // edge-to-edge), so the Material status bar overlays the chrome window's
+    // top. Hide the system bars and keep them hidden after transient swipes.
+    private void hideSystemBars() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            getWindow().setDecorFitsSystemWindows(false);
+            final WindowInsetsController controller = getWindow().getInsetsController();
+            if (controller != null) {
+                controller.hide(WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars());
+                controller.setSystemBarsBehavior(
+                        WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+            }
+        } else {
+            getWindow().getDecorView().setSystemUiVisibility(
+                    View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                            | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+                            | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                            | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
+                            | View.SYSTEM_UI_FLAG_FULLSCREEN
+                            | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
+        }
+    }
+
+    @Override
+    public void onWindowFocusChanged(final boolean hasFocus) {
+        super.onWindowFocusChanged(hasFocus);
+        if (hasFocus) {
+            hideSystemBars();
+        }
+    }
+
+    /**
+     * Touch gestures for the desktop chrome (zen-android #39). Zen shows and
+     * hides its panel on mouse hover, which has no touch equivalent, and a
+     * touch that starts over web content is taken by APZ before any chrome JS
+     * listener sees it. So the raw stream is watched here, above the view tree,
+     * and the two recognised gestures are reported to
+     * browser/.../ZenAndroidGestures.mjs over the app-wide event bus.
+     */
+    @Override
+    public boolean dispatchTouchEvent(final MotionEvent event) {
+        observeGestures(event);
+        return super.dispatchTouchEvent(event);
+    }
+
+    private void observeGestures(final MotionEvent event) {
+        if (mEdgeZonePx <= 0) {
+            return;
+        }
+        final int action = event.getActionMasked();
+
+        if (action == MotionEvent.ACTION_DOWN) {
+            mGestureDownX = event.getX();
+            mGestureDownY = event.getY();
+            mGestureDownTime = event.getEventTime();
+            mGestureFromEdge = mGestureDownX <= mEdgeZonePx;
+            mGestureReported = false;
+            mGesturePointers = 1;
+            return;
+        }
+
+        if (action == MotionEvent.ACTION_POINTER_DOWN) {
+            // A second finger means pinch or rotate, not one of our gestures.
+            mGesturePointers++;
+            mGestureFromEdge = false;
+            return;
+        }
+
+        if (action == MotionEvent.ACTION_UP) {
+            if (mGesturePointers != 1 || mGestureReported) {
+                return;
+            }
+            final float dx = event.getX() - mGestureDownX;
+            final float dy = event.getY() - mGestureDownY;
+            final boolean stayed = Math.abs(dx) <= mTapSlopPx && Math.abs(dy) <= mTapSlopPx;
+            if (stayed && event.getEventTime() - mGestureDownTime <= TAP_MAX_MS) {
+                reportGesture("tap", event.getX(), event.getY());
+            }
+            return;
+        }
+
+        if (action != MotionEvent.ACTION_MOVE || !mGestureFromEdge || mGestureReported) {
+            return;
+        }
+        final float dx = event.getX() - mGestureDownX;
+        final float dy = event.getY() - mGestureDownY;
+        if (dx >= mSwipeDistancePx && dx >= Math.abs(dy)) {
+            mGestureReported = true;
+            reportGesture("open-sidebar", event.getX(), event.getY());
+        }
+    }
+
+    private void reportGesture(final String action, final float x, final float y) {
+        final GeckoBundle message = new GeckoBundle(3);
+        message.putString("action", action);
+        message.putInt("x", (int) x);
+        message.putInt("y", (int) y);
+        Log.i(LOGTAG, "gesture: " + action + " at " + (int) x + "," + (int) y);
+        EventDispatcher.getInstance().dispatch("Zen:Gesture", message);
+    }
+
+    /**
+     * Bridges content file pickers to the Storage Access Framework. Gecko side:
+     * browser/modules/ZenAndroidFilePicker.sys.mjs sends the standard
+     * "GeckoView:Prompt" event, which the geckoview PromptController turns into
+     * onFilePrompt here; the picked URIs are materialized to local files
+     * before FilePrompt.confirm() hands them to Gecko (zen-android #37).
+     */
+    private class PromptDelegate implements GeckoSession.PromptDelegate {
+        @Override
+        public GeckoResult<PromptResponse> onFilePrompt(
+                final GeckoSession session, final FilePrompt prompt) {
+            if (mPendingFileResult != null) {
+                mPendingFileResult.complete(mPendingFilePrompt.dismiss());
+            }
+
+            final GeckoResult<PromptResponse> result = new GeckoResult<>();
+            mPendingFilePrompt = prompt;
+            mPendingFileResult = result;
+
+            final Intent intent;
+            if (prompt.type == FilePrompt.Type.FOLDER) {
+                intent =
+                        new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE)
+                                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            } else {
+                intent =
+                        new Intent(Intent.ACTION_OPEN_DOCUMENT)
+                                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                                .setType("*/*");
+                if (prompt.type == FilePrompt.Type.MULTIPLE) {
+                    intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
+                }
+                final String[] mimeTypes = prompt.mimeTypes;
+                if (mimeTypes != null && mimeTypes.length > 0) {
+                    intent.putExtra(Intent.EXTRA_MIME_TYPES, mimeTypes);
+                }
+            }
+
+            try {
+                startActivityForResult(intent, REQUEST_FILE);
+            } catch (final Exception e) {
+                Log.e(LOGTAG, "cannot open SAF picker", e);
+                mPendingFilePrompt = null;
+                mPendingFileResult = null;
+                result.complete(prompt.dismiss());
+            }
+            return result;
+        }
+    }
+
+    /**
+     * Downloads. Gecko side (already in libxul, no patch needed): nsURILoader hands
+     * unviewable responses to the external-helper-app contract, which on cairo-android
+     * resolves to GeckoViewExternalAppService (mobile/android/components/geckoview);
+     * its stream listener finds the hosting nsWindow through the content browsing
+     * context and calls nsWindow::PassExternalResponse -> this delegate (ROADMAP M4).
+     *
+     * <p>The queue goes to android.app.DownloadManager, which owns the notification and
+     * the public Downloads destination. The response is re-fetched from its (already
+     * redirected) URI, so request cookies/POST bodies are not preserved; the Gecko-side
+     * channel body is closed immediately to release the suspended request.
+     */
+    private class ContentBridge implements GeckoSession.ContentDelegate {
+        @Override
+        public void onExternalResponse(final GeckoSession session, final WebResponse response) {
+            handleExternalResponse(response);
+        }
+    }
+
+    private void handleExternalResponse(final WebResponse response) {
+        if (response.body != null) {
+            try {
+                response.body.close();
+            } catch (final Exception e) {
+                Log.w(LOGTAG, "closing external response body failed", e);
+            }
+        }
+
+        final Uri source = response.uri == null ? null : Uri.parse(response.uri);
+        final String scheme = source == null ? null : source.getScheme();
+        if (source == null || !source.isHierarchical()
+                || (!"http".equals(scheme) && !"https".equals(scheme))) {
+            Log.w(LOGTAG, "cannot download external response: " + response.uri);
+            return;
+        }
+
+        final String name = uniqueDownloadName(fileNameFor(response, source));
+        try {
+            final DownloadManager.Request request = new DownloadManager.Request(source);
+            request.setTitle(name);
+            request.setDescription(source.getHost());
+            final String mime = contentType(response, source);
+            if (mime != null) {
+                request.setMimeType(mime);
+            }
+            request.setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, name);
+            final DownloadManager dm =
+                    (DownloadManager) getSystemService(Context.DOWNLOAD_SERVICE);
+            final long id = dm.enqueue(request);
+            Log.i(LOGTAG, "M4 downloads: queued " + source + " -> " + name + " id=" + id);
+        } catch (final Exception e) {
+            Log.e(LOGTAG, "download enqueue failed for " + source, e);
+        }
+    }
+
+    private static String fileNameFor(final WebResponse response, final Uri source) {
+        String disposition = null;
+        if (response.headers != null) {
+            disposition = response.headers.get("content-disposition");
+            if (disposition == null) {
+                disposition = response.headers.get("Content-Disposition");
+            }
+        }
+        if (disposition != null) {
+            final Matcher m =
+                    Pattern.compile("filename\\*?\\s*=\\s*(?:UTF-8'')?\"?([^\";\\r\\n]+)")
+                            .matcher(disposition);
+            if (m.find()) {
+                final String candidate = Uri.decode(m.group(1)).trim();
+                if (!candidate.isEmpty()) {
+                    return new File(candidate).getName();
+                }
+            }
+        }
+        final String last = source.getLastPathSegment();
+        if (last != null && !last.isEmpty()) {
+            return new File(last).getName();
+        }
+        return "download";
+    }
+
+    private static String uniqueDownloadName(final String wanted) {
+        final File dir =
+                Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
+        if (dir == null || !new File(dir, wanted).exists()) {
+            return wanted;
+        }
+        final int dot = wanted.lastIndexOf('.');
+        final String base = dot > 0 ? wanted.substring(0, dot) : wanted;
+        final String ext = dot > 0 ? wanted.substring(dot) : "";
+        for (int i = 1; i < 1000; i++) {
+            final String candidate = base + " (" + i + ")" + ext;
+            if (!new File(dir, candidate).exists()) {
+                return candidate;
+            }
+        }
+        return base + "-" + System.currentTimeMillis() + ext;
+    }
+
+    private static String contentType(final WebResponse response, final Uri source) {
+        String mime = null;
+        if (response.headers != null) {
+            mime = response.headers.get("content-type");
+            if (mime == null) {
+                mime = response.headers.get("Content-Type");
+            }
+        }
+        if (mime != null) {
+            final int cut = mime.indexOf(';');
+            mime = (cut > 0 ? mime.substring(0, cut) : mime).trim().toLowerCase(Locale.US);
+            if (!mime.isEmpty() && !mime.equals("application/octet-stream")) {
+                return mime;
+            }
+        }
+        final String ext = MimeTypeMap.getFileExtensionFromUrl(source.toString());
+        if (ext != null) {
+            return MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext.toLowerCase(Locale.US));
+        }
+        return null;
+    }
+
+    @Override
+    protected void onActivityResult(
+            final int requestCode, final int resultCode, final Intent data) {
+        if (requestCode != REQUEST_FILE) {
+            super.onActivityResult(requestCode, resultCode, data);
+            return;
+        }
+
+        final GeckoSession.PromptDelegate.FilePrompt prompt = mPendingFilePrompt;
+        final GeckoResult<GeckoSession.PromptDelegate.PromptResponse> result = mPendingFileResult;
+        mPendingFilePrompt = null;
+        mPendingFileResult = null;
+        if (prompt == null || result == null) {
+            return;
+        }
+
+        final List<Uri> uris = new ArrayList<>();
+        if (resultCode == RESULT_OK && data != null) {
+            if (data.getData() != null) {
+                uris.add(data.getData());
+            }
+            final ClipData clip = data.getClipData();
+            if (clip != null) {
+                for (int i = 0; i < clip.getItemCount(); i++) {
+                    uris.add(clip.getItemAt(i).getUri());
+                }
+            }
+        }
+
+        if (uris.isEmpty()) {
+            result.complete(prompt.dismiss());
+            return;
+        }
+
+        if (prompt.type == GeckoSession.PromptDelegate.FilePrompt.Type.FOLDER) {
+            final Uri tree = uris.get(0);
+            try {
+                getContentResolver()
+                        .takePersistableUriPermission(
+                                tree, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            } catch (final SecurityException e) {
+                Log.w(LOGTAG, "persistable tree grant failed", e);
+            }
+            result.complete(prompt.confirm(MainActivity.this, tree));
+        } else {
+            final Uri[] local = new Uri[uris.size()];
+            for (int i = 0; i < uris.size(); i++) {
+                local[i] = materializeForGecko(uris.get(i));
+            }
+            result.complete(prompt.confirm(MainActivity.this, local));
+        }
+    }
+
+    /**
+     * Turns a SAF content:// URI into a file:// URI Gecko can open.
+     *
+     * <p>FilePrompt.confirm() only resolves content URIs from the external
+     * storage document provider to a path (e.g. downloads-provider URIs become
+     * null -> NS_ERROR_FILE_UNRECOGNIZED_PATH), and even a resolved
+     * /storage/... path is unreadable without a storage permission this app
+     * does not declare. Copying through the ContentResolver works for any
+     * provider because the URI read grant from the picker is in-process.
+     */
+    private Uri materializeForGecko(final Uri uri) {
+        if (!"content".equals(uri.getScheme())) {
+            return uri;
+        }
+
+        final File dir =
+                new File(getCacheDir(), "uploads/" + System.currentTimeMillis());
+        if (!dir.mkdirs() && !dir.isDirectory()) {
+            return uri;
+        }
+        final File out = new File(dir, displayName(uri));
+        try (final InputStream in = getContentResolver().openInputStream(uri);
+             final OutputStream os = new FileOutputStream(out)) {
+            if (in == null) {
+                return uri;
+            }
+            final byte[] buf = new byte[16384];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                os.write(buf, 0, n);
+            }
+            return Uri.fromFile(out);
+        } catch (final Exception e) {
+            Log.w(LOGTAG, "cannot copy picked uri " + uri, e);
+            return uri;
+        }
+    }
+
+    private String displayName(final Uri uri) {
+        try (final Cursor c =
+                getContentResolver()
+                        .query(
+                                uri,
+                                new String[] {OpenableColumns.DISPLAY_NAME},
+                                null,
+                                null,
+                                null)) {
+            if (c != null && c.moveToFirst()) {
+                final int idx = c.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (idx >= 0) {
+                    final String name = c.getString(idx);
+                    if (name != null && !name.isEmpty()) {
+                        return name.replace('/', '_');
+                    }
+                }
+            }
+        } catch (final Exception e) {
+        }
+        return "upload";
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mPendingFileResult != null) {
+            mPendingFileResult.complete(mPendingFilePrompt.dismiss());
+            mPendingFilePrompt = null;
+            mPendingFileResult = null;
+        }
+        if (mSession != null) {
+            mSession.close();
+            mSession = null;
+        }
+        mView = null;
+        Log.i(LOGTAG, "MainActivity destroyed");
+    }
+}
