index 89b667c7278c63866198bd4d2d9cbd2cb0ecc5cb..1252ca8e37482dafc806d19c9563b079f69b4b77 100644
--- a/mobile/android/moz.build
+++ b/mobile/android/moz.build
@@ -24,6 +24,21 @@ with Files("android-components/**"):
 # before the following files are generated. However, mechanisms in `recurse.mk`
 # are used to pull the generated files into the `pre-export` tier, so do not
 # require an explicit dependency here.
+#
+# For a standalone XUL browser built for Android (MOZ_WIDGET_TOOLKIT=android,
+# MOZ_BUILD_APP=browser), only the generated GeckoView sources below are
+# needed: they are consumed by the GeckoView Gradle bindings pipeline.  The
+# rest of this directory (Fennec APK, installer, addon generation) is not part
+# of that build.
+_is_standalone_android_browser = (
+    CONFIG["MOZ_BUILD_APP"] == "browser" and CONFIG["MOZ_WIDGET_TOOLKIT"] == "android"
+)
+
+if _is_standalone_android_browser:
+    # widget/android (GeckoWebExecutor native side) includes headers exported
+    # by these GeckoView XPCOM components; they link into libxul.
+    DIRS += ["components/geckoview"]
+
 config_keys = (
     "MOZ_ANDROID_CONTENT_SERVICE_COUNT",
     "MOZ_ANDROID_CONTENT_SERVICE_ISOLATED_PROCESS",
