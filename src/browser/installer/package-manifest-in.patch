 ; [Components]
 #ifdef ACCESSIBILITY
@@ -268,7 +272,18 @@
 ; All the pref files must be part of base to prevent migration bugs
 @RESPATH@/browser/@PREF_DIR@/firefox.js
 @RESPATH@/browser/@PREF_DIR@/firefox-branding.js
+#ifdef MOZ_WIDGET_ANDROID
+; zen-android mobile defaults (browser/app/profile/a-zen-mobile.js)
+@RESPATH@/browser/@PREF_DIR@/a-zen-mobile.js
+; On Android, greprefs.js is installed under the CPU-ABI directory
+; (modules/libpref/moz.build) and Preferences.cpp loads it through
+; MOZ_ANDROID_CPU_ABI, which GeckoLoader putenv()s before XRE_main.
+; The ABI directory is globbed because ANDROID_CPU_ARCH is a set_config,
+; which the packager does not expose as a substitution variable here.
+@RESPATH@/*/greprefs.js
+#else
 @RESPATH@/greprefs.js
+#endif
